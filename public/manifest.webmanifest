{
  "name": "Firebird DOOM",
  "short_name": "Firebird DOOM",
  "description": "DOOM simulated and rendered inside the Firebird SQL database, running in your browser via Firebird WASM.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#120d0b",
