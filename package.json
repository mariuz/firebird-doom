{
  "name": "firebird-doom",
  "version": "0.1.0",
  "private": true,
  "description": "DOOM rendered and simulated inside Firebird SQL, running in the browser via Firebird WASM",
  "type": "module",
  "scripts": {
    "fetch-wad": "node scripts/fetch-wad.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs --serve",
    "test": "node scripts/sql-smoke.mjs",
    "test:all-maps": "node scripts/all-maps.mjs",
    "test:renderers": "node scripts/compare-renderers.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "test:weapons": "node scripts/weapons-test.mjs",
    "test:specials": "node scripts/specials-test.mjs",
    "test:physics": "node scripts/physics-test.mjs",
    "test:finale": "node scripts/finale-test.mjs",
    "test:intermission": "node scripts/intermission-test.mjs",
    "test:menu": "node scripts/menu-test.mjs",
    "test:savegame": "node scripts/savegame-test.mjs",
    "test:demo": "node scripts/demo-test.mjs",
    "test:dehacked": "node scripts/dehacked-test.mjs",
    "test:pwad": "node scripts/pwad-test.mjs",
    "test:automap": "node scripts/automap-test.mjs",
    "test:light": "node scripts/light-test.mjs",
    "test:statusbar": "node scripts/statusbar-test.mjs",
    "test:sound": "node scripts/sound-test.mjs",
    "test:music": "node scripts/music-test.mjs",
    "test:netgame": "node scripts/netgame-test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:coop": "node scripts/coop-browser-test.mjs",
    "test:visual": "node scripts/screenshot.mjs --check"
  },
  "license": "MIT",
  "dependencies": {
    "firebird-wasm": "^0.3.0"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.25.0",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariuz/firebird-doom.git"
  },
  "homepage": "https://mariuz.github.io/firebird-doom/"
}
